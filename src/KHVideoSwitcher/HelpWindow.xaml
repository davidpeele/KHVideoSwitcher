<Window x:Class="KHVideoSwitcher.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KH Video Switcher — Help" Icon="/Resources/KHVideoSwitcher.ico" Height="760" Width="980" MinHeight="480" MinWidth="720"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource BodyFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="True">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="KH Video Switcher — Help" FontFamily="{StaticResource HeadingFont}" FontSize="20"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Leave this window open and switch back to the app whenever you need it — they work side by side."
                               FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource TransportOutlineButtonStyle}"
                        Height="34" Width="90" VerticalAlignment="Center" Click="Close_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="{StaticResource SurfaceBrush}">
                <StackPanel x:Name="NavPanel" Margin="12,16"/>
            </ScrollViewer>

            <Border Grid.Column="1" Width="1" Background="{StaticResource DividerBrush}"/>

            <ScrollViewer x:Name="ContentScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel" Margin="32,24,40,60" MaxWidth="700" HorizontalAlignment="Left"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
