<Window x:Class="KHVideoSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KH Video Switcher" Height="720" Width="1100"
        Background="#FF1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10,8">
            <TextBlock Text="Camera:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
            <ComboBox x:Name="CameraCombo" Width="320" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="StartStopButton" Content="Start" Width="90" Margin="12,0,0,0"
                    Padding="0,4" Click="StartStopButton_Click" IsEnabled="False"/>
            <Button x:Name="VCamButton" Content="Virtual Camera: Off" Width="150" Margin="12,0,0,0"
                    Padding="0,4" Click="VCamButton_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Background="Black" Margin="10,0,10,0" CornerRadius="4">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="10,6,10,8"
                   Foreground="#FF9CDCFE" FontFamily="Consolas" Text="Ready."/>
    </Grid>
</Window>
