<Window x:Class="KHVideoSwitcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KH Video Switcher — Settings" Height="420" Width="560"
        Background="#FF1E1E1E" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="70"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Fade duration"/>
        <Slider x:Name="FadeSlider" Grid.Column="1" Minimum="0" Maximum="1000"
                TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="Any_ValueChanged"/>
        <TextBlock x:Name="FadeLabel" Grid.Column="2" Text="300 ms" HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="OVER-THE-SHOULDER MEDIA BOX"
                   Foreground="#FF888888" FontWeight="Bold" FontSize="12"/>

        <TextBlock Grid.Row="3" Text="Media box size"/>
        <Slider x:Name="InsetSizeSlider" Grid.Row="3" Grid.Column="1" Minimum="20" Maximum="65"
                ValueChanged="Any_ValueChanged"/>
        <TextBlock x:Name="InsetSizeLabel" Grid.Row="3" Grid.Column="2" Text="42%" HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="4" Text="Border from top"/>
        <Slider x:Name="InsetTopSlider" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="300"
                ValueChanged="Any_ValueChanged"/>
        <TextBlock x:Name="InsetTopLabel" Grid.Row="4" Grid.Column="2" Text="72 px" HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="5" Text="Border from right side"/>
        <Slider x:Name="InsetRightSlider" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="300"
                ValueChanged="Any_ValueChanged"/>
        <TextBlock x:Name="InsetRightLabel" Grid.Row="5" Grid.Column="2" Text="56 px" HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Hide Windows capture highlight border"
                   ToolTip="Asks Windows not to draw the yellow border around the captured window/display. Applies the next time Capture is started."/>
        <CheckBox x:Name="HideBorderCheck" Grid.Row="7" Grid.Column="2" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Checked="Any_ValueChanged" Unchecked="Any_ValueChanged"/>

        <TextBlock Grid.Row="8" Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="#FF777777" FontSize="11"
                   Text="Changes apply immediately and are saved automatically. Tip: put PREVIEW in OTS (F3) while adjusting the media box to see it live."/>

        <Button Grid.Row="9" Grid.Column="2" Content="Close" Padding="0,6" Click="Close_Click"
                Background="#FF333333" Foreground="White" BorderBrush="#FF555555"/>
    </Grid>
</Window>
