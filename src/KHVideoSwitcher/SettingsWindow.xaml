<Window x:Class="KHVideoSwitcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KH Video Switcher — Settings" Icon="/Resources/KHVideoSwitcher.ico" Height="740" Width="520"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource BodyFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SliderCaptionStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SliderValueStyle">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- A plain top-to-bottom StackPanel, not a Grid with indexed rows: every block below
         carries its own bottom margin for spacing, so inserting/removing a section never
         requires renumbering anything else (a Grid.RowDefinitions index mismatch here has
         twice silently pushed a control off the bottom of this fixed-size window). -->
    <StackPanel Margin="22,20">

        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,20">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Settings" FontFamily="{StaticResource HeadingFont}" FontSize="18"
                           Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="VersionText" Text="v0.0.0" Style="{StaticResource SliderCaptionStyle}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="CheckUpdateButton" Content="Check for Updates" Style="{StaticResource TransportOutlineButtonStyle}"
                                Height="28" Padding="12,0" Click="CheckUpdateButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SliderCaptionStyle}"
                               HorizontalAlignment="Right" Margin="0,4,0,0" Text=""/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Crossfade duration -->
        <StackPanel Margin="0,0,0,20">
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock Text="CROSSFADE DURATION" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                <TextBlock x:Name="FadeLabel" Text="300 ms" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
            </DockPanel>
            <Slider x:Name="FadeSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="1000"
                    TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="Any_ValueChanged"/>
        </StackPanel>

        <!-- Over-the-shoulder box size -->
        <StackPanel Margin="0,0,0,20">
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock Text="OVER-THE-SHOULDER BOX SIZE" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                <TextBlock x:Name="InsetSizeLabel" Text="42%" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
            </DockPanel>
            <Slider x:Name="InsetSizeSlider" Style="{StaticResource AccentSliderStyle}" Minimum="10" Maximum="50"
                    ValueChanged="Any_ValueChanged"/>
        </StackPanel>

        <!-- Box top / right margins -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock Text="BOX TOP MARGIN" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="InsetTopLabel" Text="72 px" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
                </DockPanel>
                <Slider x:Name="InsetTopSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="80"
                        ValueChanged="Any_ValueChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock Text="BOX RIGHT MARGIN" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="InsetRightLabel" Text="56 px" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
                </DockPanel>
                <Slider x:Name="InsetRightSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="80"
                        ValueChanged="Any_ValueChanged"/>
            </StackPanel>
        </Grid>

        <!-- Live preview of the OTS inset box position/size -->
        <Border Width="220" Height="130" Background="{StaticResource VideoPaneFillBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Canvas>
                <Border x:Name="InsetPreviewBox" Background="{StaticResource AccentBrush}" Opacity="0.85"/>
            </Canvas>
        </Border>

        <StackPanel Margin="0,0,0,20">
            <Button x:Name="HideBorderTag" Style="{StaticResource StatusTagStyle}" Margin="0,0,0,8" HorizontalAlignment="Left"
                    Click="HideBorderTag_Click"
                    ToolTip="Asks Windows not to draw the yellow border around the captured window/display. Applies the next time Capture is started.">
                <TextBlock><Run Text="HIDE CAPTURE BORDER · "/><Run x:Name="HideBorderStateRun" Text="ON"/></TextBlock>
            </Button>
            <Button x:Name="OtsShiftTag" Style="{StaticResource StatusTagStyle}" Margin="0,0,0,8" HorizontalAlignment="Left"
                    Click="OtsShiftTag_Click"
                    ToolTip="When OVER-THE-SHOULDER is on, shifts the camera view left so the media inset doesn't cover the subject.">
                <TextBlock><Run Text="SHIFT CAMERA FOR OTS · "/><Run x:Name="OtsShiftStateRun" Text="OFF"/></TextBlock>
            </Button>
            <Button x:Name="FullScreenFirstTag" Style="{StaticResource StatusTagStyle}" HorizontalAlignment="Left"
                    Click="FullScreenFirstTag_Click"
                    ToolTip="When AUTO is on, new media (video or still) always goes full screen first instead of images going to the over-the-shoulder inset. You can still switch to OVER-THE-SHOULDER manually.">
                <TextBlock><Run Text="ALWAYS FULL SCREEN FIRST · "/><Run x:Name="FullScreenFirstStateRun" Text="OFF"/></TextBlock>
            </Button>
            <Button x:Name="SettingsUpdateTag" Style="{StaticResource StatusTagStyle}" Click="SettingsUpdateTag_Click" Visibility="Collapsed"
                    HorizontalAlignment="Left" Margin="0,8,0,0"
                    ToolTip="A newer version of KH Video Switcher is available. Click to download, verify, and install it.">
                <TextBlock><Run Text="UPDATE · "/><Run x:Name="SettingsUpdateStateRun" Text="AVAILABLE"/></TextBlock>
            </Button>
        </StackPanel>

        <!-- Amount the camera shifts left when SHIFT CAMERA FOR OTS is on -->
        <StackPanel Margin="0,0,0,20">
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock Text="OTS SHIFT AMOUNT" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                <TextBlock x:Name="ShiftAmountLabel" Text="5%" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
            </DockPanel>
            <Slider x:Name="ShiftAmountSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="40"
                    ValueChanged="Any_ValueChanged"/>
        </StackPanel>

        <!-- OTS background fill: the color revealed off-camera when OTS shifts the frame -->
        <StackPanel Margin="0,0,0,10">
            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <TextBlock Text="OTS BACKGROUND COLOR" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Border x:Name="BgColorPreview" Width="28" Height="28" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" DockPanel.Dock="Right"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ColorSwatchStyle}" Background="Black" Tag="#000000" Click="BgPreset_Click" Margin="0,0,8,0" ToolTip="Black"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#F8F5F0" Tag="#F8F5F0" Click="BgPreset_Click" Margin="0,0,8,0" ToolTip="Off-White"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#E8DCC0" Tag="#E8DCC0" Click="BgPreset_Click" Margin="0,0,8,0" ToolTip="Beige"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="White" Tag="#FFFFFF" Click="BgPreset_Click" Margin="0,0,8,0" ToolTip="White"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#808080" Tag="#808080" Click="BgPreset_Click" ToolTip="Gray"/>
            </StackPanel>
        </StackPanel>

        <!-- Custom background color -->
        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,20">
            <StackPanel Margin="0,0,8,0">
                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock Text="R" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="BgRLabel" Text="0" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
                </DockPanel>
                <Slider x:Name="BgRSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="255" ValueChanged="BgRgb_ValueChanged"/>
            </StackPanel>
            <StackPanel Margin="4,0,4,0">
                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock Text="G" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="BgGLabel" Text="0" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
                </DockPanel>
                <Slider x:Name="BgGSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="255" ValueChanged="BgRgb_ValueChanged"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock Text="B" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="BgBLabel" Text="0" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
                </DockPanel>
                <Slider x:Name="BgBSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="255" ValueChanged="BgRgb_ValueChanged"/>
            </StackPanel>
        </UniformGrid>

        <!-- OTS inset border: optional thin outline around the picture-in-picture box -->
        <StackPanel Margin="0,0,0,10">
            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <TextBlock Text="OTS BORDER" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Border x:Name="BorderColorPreview" Width="28" Height="28" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" DockPanel.Dock="Right"/>
            </DockPanel>
            <Button x:Name="ShowOtsBorderTag" Style="{StaticResource StatusTagStyle}" HorizontalAlignment="Left" Margin="0,0,0,8"
                    Click="ShowOtsBorderTag_Click"
                    ToolTip="Draws a thin outline around the over-the-shoulder picture box, in the color below.">
                <TextBlock><Run Text="SHOW BORDER · "/><Run x:Name="ShowOtsBorderStateRun" Text="OFF"/></TextBlock>
            </Button>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ColorSwatchStyle}" Background="Black" Tag="#000000" Click="BorderPreset_Click" Margin="0,0,8,0" ToolTip="Black"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#F8F5F0" Tag="#F8F5F0" Click="BorderPreset_Click" Margin="0,0,8,0" ToolTip="Off-White"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#E8DCC0" Tag="#E8DCC0" Click="BorderPreset_Click" Margin="0,0,8,0" ToolTip="Beige"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="White" Tag="#FFFFFF" Click="BorderPreset_Click" Margin="0,0,8,0" ToolTip="White"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#808080" Tag="#808080" Click="BorderPreset_Click" ToolTip="Gray"/>
            </StackPanel>
        </StackPanel>

        <!-- Custom border color -->
        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,20">
            <StackPanel Margin="0,0,8,0">
                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock Text="R" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="BorderRLabel" Text="0" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
                </DockPanel>
                <Slider x:Name="BorderRSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="255" ValueChanged="BorderRgb_ValueChanged"/>
            </StackPanel>
            <StackPanel Margin="4,0,4,0">
                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock Text="G" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="BorderGLabel" Text="0" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
                </DockPanel>
                <Slider x:Name="BorderGSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="255" ValueChanged="BorderRgb_ValueChanged"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock Text="B" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="BorderBLabel" Text="0" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
                </DockPanel>
                <Slider x:Name="BorderBSlider" Style="{StaticResource AccentSliderStyle}" Minimum="0" Maximum="255" ValueChanged="BorderRgb_ValueChanged"/>
            </StackPanel>
        </UniformGrid>

        <!-- Divider between the video/output settings above and the audio settings below -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="AUDIO" Style="{StaticResource SectionCaptionStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border Grid.Column="1" Height="1" Background="{StaticResource DividerBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Audio input device: picked once, so it lives here rather than the toolbar -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="AUDIO INPUT DEVICE" Style="{StaticResource SliderCaptionStyle}" Margin="0,0,0,6"/>
            <DockPanel LastChildFill="False">
                <ComboBox x:Name="AudioDeviceCombo" Style="{StaticResource ToolbarComboStyle}" Width="260" DockPanel.Dock="Left"
                          DropDownOpened="AudioDeviceCombo_DropDownOpened" SelectionChanged="AudioDeviceCombo_SelectionChanged"
                          ToolTip="Audio input to watch (e.g. the amplifier line-in) - shown for reference only, this app never records, sends, or mixes it"/>
                <Button x:Name="ShowAudioMeterTag" Style="{StaticResource StatusTagStyle}" DockPanel.Dock="Right"
                        Click="ShowAudioMeterTag_Click"
                        ToolTip="Shows or hides the audio input level meter under PROGRAM.">
                    <TextBlock><Run Text="SHOW AUDIO METER · "/><Run x:Name="ShowAudioMeterStateRun" Text="ON"/></TextBlock>
                </Button>
            </DockPanel>
        </StackPanel>

        <!-- Audio meter calibration: added to the raw dB reading before it's displayed -->
        <StackPanel Margin="0,0,0,20">
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock Text="AUDIO METER GAIN" Style="{StaticResource SliderCaptionStyle}" DockPanel.Dock="Left"/>
                <TextBlock x:Name="AudioGainLabel" Text="0 dB" Style="{StaticResource SliderValueStyle}" DockPanel.Dock="Right"/>
            </DockPanel>
            <Slider x:Name="AudioGainSlider" Style="{StaticResource AccentSliderStyle}" Minimum="-24" Maximum="24"
                    TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Any_ValueChanged"/>
        </StackPanel>

        <Button Content="Close" Style="{StaticResource TransportOutlineButtonStyle}" Height="38" Width="100"
                HorizontalAlignment="Right" Click="Close_Click"/>
    </StackPanel>
    </ScrollViewer>
</Window>
